diff --git a/src/c/arrange_core.h b/src/c/arrange_core.h
index 2da4d96..fac827d 100644
--- a/src/c/arrange_core.h
+++ b/src/c/arrange_core.h
@@ -1102,6 +1102,542 @@ static __attribute__((noinline)) int SUPPORT_AGAIN(sstate_t *s, int d,
                                                    int a) {
   return SUPPORT(s, d, a, 1);
 }
+
+#if defined(CLASS_SUP) && defined(CARRY)
+/*
+ * MEASUREMENT ONLY (-DCLASS_SUP, env CLASS_SUP=1): the class-aware support
+ * filter of a V_d search. Every vector of V_d has exactly one of d's
+ * numbers (its class: the top ncls labels), so a candidate col of class j
+ * meets every row of class j at a_j, and a cell z != a_j of it cannot lie
+ * in its row of the square if that row has class j. So each non-d cell of
+ * a candidate of class j must be covered by a placed vector of the other
+ * axis or by a candidate of the other axis of another class (its d cell by
+ * a class-j one, as in SUPPORT). Scalar, iterated to the fixpoint on both
+ * axes, after SUPPORT; counts only, not timing.
+ */
+#define CLS_OF CAT(cls_of, W)
+static inline int CLS_OF(const sstate_t *s, const uint64_t *list, size_t cap,
+                         uint32_t i) {
+  for (int w = W - 1; w >= 0; w--) {
+    const uint64_t t = list[w * cap + i] & s->clsmask[w];
+    if (t)
+      return (int)(s->L - 1 - (64 * w + __builtin_ctzll(t)));
+  }
+  return 0; /* (cannot happen in a V_d search) */
+}
+#ifndef CLS_PM_DEFINED
+#define CLS_PM_DEFINED
+/* bit S of HAS[c]: subset S of the 6 classes contains c */
+static uint64_t cls_has[8];
+static void cls_has_init(void) {
+  for (int c = 0; c < 6; c++) {
+    cls_has[c] = 0;
+    for (int S = 0; S < 64; S++)
+      if (S >> c & 1)
+        cls_has[c] |= (uint64_t)1 << S;
+  }
+}
+/* does the bipartite graph cells t < m (adj[t]: class mask) x classes have
+ * a matching saturating the cells whose classes are exactly `full`? */
+static int cls_pm(const int *adj, int m, int full) {
+  uint64_t reach = 1;
+  for (int t = 0; t < m; t++) {
+    uint64_t nr = 0;
+    for (int c = 0; c < 6; c++)
+      if (adj[t] >> c & 1)
+        nr |= (reach & ~cls_has[c]) << (1 << c);
+    reach = nr;
+    if (!reach)
+      return 0;
+  }
+  return (int)(reach >> full & 1);
+}
+#endif
+#define CLS_BOUNDS CAT(cls_bounds, W)
+#define CLASS_VEC CAT(class_vec, W)
+/* the class blocks of a class-sorted list: block c is [b[c], b[c + 1]) */
+static void CLS_BOUNDS(const sstate_t *s, const uint64_t *list, uint32_t cnt,
+                       uint32_t *b) {
+  const size_t cap = s->cap;
+  const int nc = s->ncls;
+  uint32_t i = 0;
+  for (int c = 0; c < nc; c++) {
+    b[c] = i;
+    /* first index >= i whose class is > c (classes ascend) */
+    uint32_t lo = i, hi = cnt;
+    while (lo < hi) {
+      const uint32_t mid = lo + (hi - lo) / 2;
+      if (CLS_OF(s, list, cap, mid) <= c)
+        lo = mid + 1;
+      else
+        hi = mid;
+    }
+    i = lo;
+  }
+  b[nc] = cnt;
+}
+/*
+ * Vectorized class check (level 2): on class-sorted carried lists, block by
+ * block, an entry of class j is dropped if a cell of it is not in a placed
+ * vector of the other axis nor in an other-axis candidate of another class
+ * (its d cell: of class j), or if some class c != j, not placed on the
+ * other axis, has no candidate there that meets it outside the placed
+ * vectors. Both axes, to the fixpoint. Returns nonzero if the node is dead.
+ */
+static __attribute__((noinline)) int CLASS_VEC(sstate_t *s, int d, int a) {
+  const int n = s->n, nc = s->ncls;
+  const size_t cap = s->cap;
+  uint64_t G[2][SQ_MAX_N][W];
+  uint32_t bnd[2][SQ_MAX_N + 1];
+  int pcls[2] = {0, 0};
+  for (int ax = 0; ax < 2; ax++) {
+    for (int q = 0; q < s->np[ax]; q++) {
+      const uint64_t *pw = s->placedw[ax][q];
+      for (int w = W - 1; w >= 0; w--)
+        if (pw[w] & s->clsmask[w]) {
+          pcls[ax] |= 1 << (int)(s->L - 1 - (64 * w + __builtin_ctzll(
+                                                          pw[w] & s->clsmask[w])));
+          break;
+        }
+    }
+    CLS_BOUNDS(s, s->vw[d][ax], s->nvalid[d][ax], bnd[ax]);
+  }
+  /* the per-class unions of the other axis of the first pass */
+  {
+    const int oa = 1 - a;
+    const uint64_t *list = s->vw[d][oa];
+    for (int c = 0; c < nc; c++) {
+      __m512i acc[W];
+      for (int w = 0; w < W; w++)
+        acc[w] = _mm512_setzero_si512();
+      for (uint32_t i = bnd[oa][c]; i < bnd[oa][c + 1]; i += 8) {
+        const uint32_t r = bnd[oa][c + 1] - i;
+        const __mmask8 live = r >= 8 ? 0xff : (__mmask8)((1u << r) - 1);
+        for (int w = 0; w < W; w++)
+          acc[w] = _mm512_or_si512(
+              acc[w], _mm512_maskz_loadu_epi64(live, list + w * cap + i));
+      }
+      for (int w = 0; w < W; w++)
+        G[oa][c][w] = (uint64_t)_mm512_reduce_or_epi64(acc[w]);
+    }
+  }
+  int quiet = 0, first = 1;
+  int lvl = s->cls_level >= 5 ? 2 : s->cls_level; /* the pairs last */
+  for (;;) {
+    if (quiet >= 2) {
+      if (lvl < s->cls_level) {
+        lvl = s->cls_level;
+        quiet = 0;
+      } else {
+        break;
+      }
+    }
+    const int oa = 1 - a;
+    const uint64_t *C = s->cells[d][oa];
+    uint64_t *list = s->vw[d][a];
+    uint64_t allc[W];
+    for (int w = 0; w < W; w++) {
+      allc[w] = 0;
+      for (int c = 0; c < nc; c++)
+        allc[w] |= G[oa][c][w];
+    }
+    uint32_t k = 0;
+    const uint32_t cnt0 = s->nvalid[d][a];
+    uint32_t nb[SQ_MAX_N + 1];
+    uint64_t un[W];
+    for (int w = 0; w < W; w++)
+      un[w] = 0;
+    for (int j = 0; j < nc; j++) {
+      nb[j] = k;
+      const uint32_t b0 = bnd[a][j], b1 = bnd[a][j + 1];
+      if (b0 == b1) {
+        for (int w = 0; w < W; w++)
+          G[a][j][w] = 0;
+        continue;
+      }
+      /* bad cells for class j; the other classes' coverable cells */
+      __m512i BAD[W], GX[SQ_MAX_N][W];
+      int ncx = 0, dead_block = 0;
+      for (int w = 0; w < W; w++) {
+        uint64_t oth = 0;
+        for (int c = 0; c < nc; c++)
+          if (c != j)
+            oth |= G[oa][c][w];
+        BAD[w] = _mm512_set1_epi64(
+            (long long)~(C[w] | (G[oa][j][w] & s->clsmask[w]) | oth));
+      }
+      for (int c = 0; c < nc; c++) {
+        if (c == j || (pcls[oa] >> c & 1))
+          continue;
+        uint64_t any = 0;
+        for (int w = 0; w < W; w++) {
+          const uint64_t g = G[oa][c][w] & ~C[w];
+          any |= g;
+          GX[ncx][w] = _mm512_set1_epi64((long long)g);
+        }
+        if (!any)
+          dead_block = 1;
+        ncx++;
+      }
+      /* the cells only class c covers (of the available classes) */
+      __m512i XO[SQ_MAX_N][W];
+      if (lvl == 6)
+        for (int c = 0; c < ncx; c++)
+          for (int w = 0; w < W; w++) {
+            __m512i o = _mm512_setzero_si512();
+            for (int c2 = 0; c2 < ncx; c2++)
+              if (c2 != c)
+                o = _mm512_or_si512(o, GX[c2][w]);
+            XO[c][w] = _mm512_andnot_si512(o, GX[c][w]);
+          }
+      __m512i acc[W];
+      for (int w = 0; w < W; w++)
+        acc[w] = _mm512_setzero_si512();
+      if (!dead_block)
+        for (uint32_t i = b0; i < b1; i += 8) {
+          const uint32_t r = b1 - i;
+          const __mmask8 live = r >= 8 ? 0xff : (__mmask8)((1u << r) - 1);
+          __m512i x[W];
+          for (int w = 0; w < W; w++)
+            x[w] = _mm512_maskz_loadu_epi64(live, list + w * cap + i);
+          __m512i t = _mm512_and_si512(x[0], BAD[0]);
+          for (int w = 1; w < W; w++)
+            t = _mm512_ternarylogic_epi64(t, x[w], BAD[w], 0xF8);
+          __mmask8 keep = _mm512_mask_testn_epi64_mask(live, t, t);
+          for (int c = 0; c < ncx && keep; c++) {
+            __m512i h = _mm512_and_si512(x[0], GX[c][0]);
+            for (int w = 1; w < W; w++)
+              h = _mm512_ternarylogic_epi64(h, x[w], GX[c][w], 0xF8);
+            keep = _mm512_mask_test_epi64_mask(keep, h, h);
+          }
+          if (lvl == 6 && keep) {
+            /* cell side pairs: two cells of the entry that only class c
+             * (of the available ones) covers */
+            for (int c = 0; c < ncx && keep; c++) {
+              __m512i cn = _mm512_setzero_si512();
+              for (int w = 0; w < W; w++)
+                cn = _mm512_add_epi64(
+                    cn, _mm512_popcnt_epi64(_mm512_and_si512(x[w], XO[c][w])));
+              keep = _mm512_mask_cmplt_epi64_mask(keep, cn,
+                                                  _mm512_set1_epi64(2));
+            }
+          }
+          if (lvl >= 5 && keep && ncx >= 2) {
+            /* class side pairs: two available classes whose only cell of
+             * the entry is the same cell */
+            __m512i H[SQ_MAX_N][W];
+            __mmask8 one[SQ_MAX_N];
+            for (int c = 0; c < ncx; c++) {
+              __m512i cn = _mm512_setzero_si512();
+              for (int w = 0; w < W; w++) {
+                H[c][w] = _mm512_and_si512(x[w], GX[c][w]);
+                cn = _mm512_add_epi64(cn, _mm512_popcnt_epi64(H[c][w]));
+              }
+              one[c] = _mm512_mask_cmpeq_epi64_mask(keep, cn,
+                                                    _mm512_set1_epi64(1));
+            }
+            __mmask8 viol = 0;
+            for (int c = 0; c < ncx; c++) {
+              if (!one[c])
+                continue;
+              for (int c2 = c + 1; c2 < ncx; c2++) {
+                __mmask8 m = one[c] & one[c2];
+                for (int w = 0; w < W && m; w++)
+                  m = _mm512_mask_cmpeq_epi64_mask(m, H[c][w], H[c2][w]);
+                viol |= m;
+              }
+            }
+            keep &= (__mmask8)~viol;
+          }
+          const int nk = __builtin_popcount(keep);
+          const __mmask8 sm = (__mmask8)((1u << nk) - 1);
+          for (int w = 0; w < W; w++) {
+            __m512i y = _mm512_maskz_compress_epi64(keep, x[w]);
+            _mm512_mask_storeu_epi64(list + w * cap + k, sm, y);
+            acc[w] = _mm512_or_si512(acc[w], y);
+          }
+          k += (uint32_t)nk;
+        }
+      for (int w = 0; w < W; w++) {
+        G[a][j][w] = (uint64_t)_mm512_reduce_or_epi64(acc[w]);
+        un[w] |= G[a][j][w];
+      }
+    }
+    nb[nc] = k;
+    for (int j = 0; j <= nc; j++)
+      bnd[a][j] = nb[j];
+    cls_passes[9 * s->np[ROW] + s->np[COL]]++;
+    if (k == cnt0 && !first) {
+      quiet++;
+    } else {
+      quiet = k == cnt0 ? quiet + 1 : 1;
+      s->nvalid[d][a] = k;
+      for (int w = 0; w < W; w++)
+        s->uni[d][a][w] = un[w];
+      if (s->np[a] + (int)k < n)
+        return 1;
+      const uint64_t *Ca = s->cells[d][a];
+      uint64_t dead = 0;
+      for (int w = 0; w < W; w++)
+        dead |= C[w] & ~Ca[w] & ~un[w];
+      if (dead)
+        return 2;
+    }
+    first = 0;
+    a = oa;
+  }
+  return 0;
+}
+#define CLASS_FIX CAT(class_fix, W)
+static __attribute__((noinline)) int CLASS_FIX(sstate_t *s, int d, int a,
+                                               int pl) {
+  const int n = s->n, nc = s->ncls;
+  const size_t cap = s->cap;
+  int quiet = 0;
+  while (quiet < 2) {
+    const int oa = 1 - a;
+    uint64_t G[SQ_MAX_N][W];
+    memset(G, 0, sizeof(G));
+    const uint64_t *lo = s->vw[d][oa];
+    const uint32_t co = s->nvalid[d][oa];
+    for (uint32_t i = 0; i < co; i++) {
+      const int c = CLS_OF(s, lo, cap, i);
+      for (int w = 0; w < W; w++)
+        G[c][w] |= lo[w * cap + i];
+    }
+    const uint64_t *C = s->cells[d][oa];
+    uint64_t A[SQ_MAX_N][W];
+    for (int j = 0; j < nc; j++)
+      for (int w = 0; w < W; w++) {
+        uint64_t x = C[w] | (G[j][w] & s->clsmask[w]);
+        for (int c = 0; c < nc; c++)
+          if (c != j)
+            x |= G[c][w];
+        A[j][w] = x;
+      }
+    uint64_t *la = s->vw[d][a];
+    const uint32_t ca = s->nvalid[d][a];
+    /* placed-vector permutations: the a-vectors of the square meet a placed
+     * oa-vector p at distinct cells and have distinct classes, so the
+     * unmatched cells of p and the classes not placed on axis a are
+     * matched perfectly by the a candidates (cell y ~ class c iff an
+     * a candidate of class c meets p at y; a non-d cell of p never by p's
+     * class, its d cell only by it); an a candidate of class c meeting p
+     * at y needs (y, c) in some perfect matching */
+    uint64_t AL[SQ_MAX_N][SQ_MAX_N][W];
+    const int nqp = s->cls_perm ? s->np[oa] : 0;
+    if (nqp) {
+      if (!cls_has[1])
+        cls_has_init();
+      uint64_t Ga[SQ_MAX_N][W];
+      memset(Ga, 0, sizeof(Ga));
+      for (uint32_t i = 0; i < ca; i++) {
+        const int c = CLS_OF(s, la, cap, i);
+        for (int w = 0; w < W; w++)
+          Ga[c][w] |= la[w * cap + i];
+      }
+      int pca = 0; /* classes placed on axis a */
+      for (int q = 0; q < s->np[a]; q++) {
+        const uint64_t *pw = s->placedw[a][q];
+        for (int w = W - 1; w >= 0; w--)
+          if (pw[w] & s->clsmask[w]) {
+            pca |= 1 << (int)(s->L - 1 -
+                              (64 * w + __builtin_ctzll(pw[w] & s->clsmask[w])));
+            break;
+          }
