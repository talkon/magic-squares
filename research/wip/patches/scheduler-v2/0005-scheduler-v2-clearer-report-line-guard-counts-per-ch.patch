From edf4cd221bab669b591993f434fde3fbb5c932cd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 15:21:52 +0000
Subject: [PATCH 5/5] scheduler v2: clearer report line, guard counts per
 chunk, run in the enumerate audit

The no-enumerate test now also runs the analytic run loop in-process (only
msearch may be started); the profile store writes its guard counts after
every chunk so a killed fill keeps them; the README states the v2 forecast
and its gain over the regression scheduler under the same model.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GSaYLGdzq6d82nBLeSZFgB
---
 README.md                 |  9 +++++++--
 scripts/scheduler.py      | 11 +++++++----
 scripts/test_scheduler.py |  7 +++++++
 3 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/README.md b/README.md
index 10b1894..c11a348 100644
--- a/README.md
+++ b/README.md
@@ -169,12 +169,17 @@ data and tested on data it was not fitted to, up to N = 45k vectors per sum.
 * Expected magic squares found with the current build and an ideal choice of
   (P, S): **0.16 in 1 CPU-year, 0.34 in 10, 0.64 in 100, 1.1 in 1,000**
   (68% band x/÷2). Everything searched so far holds ~0.005.
-* The scheduler as fitted would collect about 10x less
+* The regression scheduler as fitted would collect about 10x less
   ([research/forecast.md](research/forecast.md): 0.015-0.018 in 1 CPU-year).
   Its model of squares per sum stops growing at N ~ 5,500 (it predicts 88
   squares where 484 were found at N = 5-8k, and 0.08 where 60 were found at
   N = 15-32k), and its pool omits exponent orders that are not
-  non-increasing, which hold more than half of the yield.
+  non-increasing, which hold about half of the yield. The analytic
+  scheduler (now the default) forecasts **0.13 magic squares in 1
+  CPU-year and 0.30 in 10** (`forecast --shipped`; 90% band from its
+  calibration uncertainty 0.04-0.40 and 0.08-0.98); scored by the same
+  analytic model, the regression scheduler's choices would collect 0.059 and
+  0.105, i.e. the new one is x2.3 / x2.8 better if the model is right.
 * Speedups are best compared by the ratio of E at a fixed budget: 10x faster
   gives x2.2 at 1 CPU-year and x1.5 at 1,000; time ~ N^2 instead of ~N^4
   beyond N = 4,000 gives x1.1 and x1.7.
diff --git a/scripts/scheduler.py b/scripts/scheduler.py
index b1d2464..be71e6f 100644
--- a/scripts/scheduler.py
+++ b/scripts/scheduler.py
@@ -1676,6 +1676,8 @@ class ProfileStore:
             self.done.flush()
             for j, g in enumerate(am.GUARDS):
                 self.guards[g] = self.guards.get(g, 0) + int(gc[:, j].sum())
+            self.meta["guards"] = self.guards
+            self._write_meta(self.meta)
 
         if workers <= 1 or len(chunks) == 1:
             am.worker_init() if workers <= 1 and len(rows) > 50 else None
@@ -2663,11 +2665,12 @@ def am_s0(P):
 
 
 def describe_calib(calib, tm):
-    lg, lS, lP, lm = calib.rates()
+    """one line: the data behind the class factors, and the current time law"""
     d = calib.data
     parts = [f"{k} obs/exp {d[k][0]:.0f}/{d[k][1]:.1f}" for k in ("sq", "S", "P") if k in d]
-    return (", ".join(parts) + f"; time engine {tm.engine} th=" +
-            "[" + ", ".join(f"{v:.3f}" for v in tm.th) + f"] sd {tm.sd:.3f} ({tm.n} sums)")
+    return ("class-factor data: " + (", ".join(parts) or "none")
+            + f"; time law (engine {tm.engine}): th=["
+            + ", ".join(f"{v:.3f}" for v in tm.th) + f"] sd {tm.sd:.3f} ({tm.n} sums)")
 
 
 def _poisson_interval(o, e, z=1.645):
@@ -2721,7 +2724,7 @@ def report_v2(sch, top=20, out=None):
         b, C = sch.calib.beta[key], sch.calib.cov[key]
         pr(f"  {name:13} " + ", ".join(f"{e} {v:+.2f}({math.sqrt(C[i, i]):.2f})"
                                        for i, (e, v) in enumerate(zip(EFFECTS, b))))
-    pr(f"  time: {describe_calib(sch.calib, sch.tm)}")
+    pr(f"  {describe_calib(sch.calib, sch.tm)}")
     for k, tm in sorted(sch.time_models.items()):
         pr(f"    engine:mode {k}: th=[{', '.join(f'{v:.3f}' for v in tm.th)}] sd {tm.sd:.3f} "
            f"({tm.n} sums)")
