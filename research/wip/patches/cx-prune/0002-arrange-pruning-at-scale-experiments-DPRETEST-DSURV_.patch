+               "\"nodes\":%llu,\"cyc\":%llu,\"lists\":%llu,\"t\":[",
+            p > 1 ? "," : "", p, (unsigned long long)pd_tested[p],
+            (unsigned long long)pd_prod[p], (unsigned long long)pd_alive[p],
+            (unsigned long long)pd_nodes[p], (unsigned long long)pd_cyc[p],
+            (unsigned long long)pd_lists[p]);
+    fprintf(f, "],\"mrv_in\":%llu,\"mrv_out\":[", (unsigned long long)pd_mrv_in[p]);
+    for (int t = 0; t < PD_NT; t++)
+      fprintf(f, "%s%llu", t ? "," : "", (unsigned long long)pd_mrv_out[p][t]);
+    fprintf(f, "],\"t2\":[");
+    for (int t = 0; t < PD_NT; t++)
+      fprintf(f, "%s[%llu,%llu,%llu,%llu,%llu,%llu]", t ? "," : "",
+              (unsigned long long)pd_killed[p][t],
+              (unsigned long long)pd_kprod[p][t],
+              (unsigned long long)pd_knodes[p][t],
+              (unsigned long long)pd_kcyc[p][t],
+              (unsigned long long)pd_tests[p][t],
+              (unsigned long long)pd_left[p][t]);
+    fprintf(f, "]}");
+  }
+  fprintf(f, "],\"diag\":[%llu,%llu,%llu,%llu,%llu,%llu]", (unsigned long long)pdd_n,
+          (unsigned long long)pdd_sum, (unsigned long long)pdd_pair,
+          (unsigned long long)pdd_kids, (unsigned long long)pdd_kept,
+          (unsigned long long)pdd_kd);
+  fprintf(f, ",\"r11\":[%llu,%llu,%llu,%llu,%llu,%llu,%llu]}\n",
+          (unsigned long long)pd11_tested, (unsigned long long)pd11_build,
+          (unsigned long long)pd11_sub, (unsigned long long)pd11_pairs,
+          (unsigned long long)pd11_rows, (unsigned long long)pd11_cols,
+          (unsigned long long)pd11_nodes);
+  if (fn)
+    fclose(f);
+}
+#endif
+
+#ifdef SURV_FIX
+static uint32_t surv_fix_min;
+static int surv_fix_rounds = 1000;
+static int force_after; /* env FORCE_AFTER: 1 = support filter first, -1 = cross first */
+static void __attribute__((constructor)) surv_fix_init(void) {
+  if (getenv("SURV_FIX_ROUNDS"))
