+}
+#endif
 /* instantiate the recursive search for each bitset width */
 #define W 2
 #include "arrange_core.h"
@@ -753,6 +848,10 @@ search_stats_t search_vectors(const vec_list_t *l, size_t start, size_t count,
 
   sstate_t s;
   memset(&s, 0, sizeof(s));
+#ifdef SURV_FIX
