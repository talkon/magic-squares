diff --git a/src/c/arrange_core.h b/src/c/arrange_core.h
index e2e12cb..01a960d 100644
--- a/src/c/arrange_core.h
+++ b/src/c/arrange_core.h
@@ -218,6 +218,71 @@ static inline uint32_t FILTER_CARRY(const sstate_t *s, const uint64_t *in,
   return k;
 }
 
+#ifdef PRETEST
+/*
+ * Experiment (cx/prune): FILTER_CARRY without the output, for the children
+ * five vectors deep, which nearly all die at the count or forward check
+ * right after the two filters: the number of entries it would keep and
+ * their union, with no compress or store. Same precondition (padding).
+ */
+#define FILTER_COUNT CAT(filter_count, W)
+static inline uint32_t FILTER_COUNT(const sstate_t *s, const uint64_t *in,
+                                    uint32_t cnt, const uint64_t *vb,
+                                    const int once, const uint64_t *excl,
+                                    uint64_t *un /* [W] */) {
+  const size_t cap = s->cap;
+  __m512i V[W], R[W], acc[W];
+  bool tw[W];
+  uint64_t used = 0;
+  for (int w = 0; w < W; w++) {
+    uint64_t t = vb[w] | (!once && excl ? excl[w] : 0);
+    int r = 0;
+    if (once && w > 0)
+      while (rotl64(t, r) & used)
+        r++;
+    t = rotl64(t, r);
+    used |= t;
+    V[w] = _mm512_set1_epi64((long long)t);
+    R[w] = _mm512_set1_epi64(r);
+    acc[w] = _mm512_setzero_si512();
+    tw[w] = W <= 2 || t;
+  }
+  uint32_t k = 0;
+  for (uint32_t i = 0; i < cnt; i += 8) {
+    __m512i x[W];
+    for (int w = 0; w < W; w++)
+      x[w] = _mm512_loadu_si512(in + w * cap + i);
+    __mmask8 keep;
+    if (once) {
+      __m512i c = _mm512_and_si512(x[0], V[0]);
+      for (int w = 1; w < W; w++)
+        if (tw[w])
+          c = _mm512_ternarylogic_epi64(c, _mm512_rolv_epi64(x[w], R[w]),
+                                        V[w], 0xF8);
+#ifdef __AVX512VPOPCNTDQ__
+      keep = _mm512_cmpeq_epi64_mask(_mm512_popcnt_epi64(c),
+                                     _mm512_set1_epi64(1));
+#else
+      keep = _mm512_mask_testn_epi64_mask(
+          _mm512_test_epi64_mask(c, c), c,
+          _mm512_sub_epi64(c, _mm512_set1_epi64(1)));
+#endif
+    } else {
+      keep = 0xff;
+      for (int w = 0; w < W; w++)
+        if (tw[w])
+          keep = _mm512_mask_testn_epi64_mask(keep, x[w], V[w]);
+    }
+    for (int w = 0; w < W; w++)
+      acc[w] = _mm512_mask_or_epi64(acc[w], keep, acc[w], x[w]);
+    k += (uint32_t)__builtin_popcount(keep);
+  }
+  for (int w = 0; w < W; w++)
+    un[w] = (uint64_t)_mm512_reduce_or_epi64(acc[w]);
+  return k;
+}
+#endif
+
 /* pads list[0..cnt) with 8 full sets, for FILTER_CARRY: a node pads its
  * lists before creating its children, which filter them (once per node,
  * not at each filter: the store right before the loads of the last group
@@ -948,6 +1013,329 @@ static __attribute__((noinline)) int SUPPORT_AGAIN(sstate_t *s, int d,
 
 static void SEARCH_REC(sstate_t *s, int d);
 
+#if defined(PRUNE_DIAG) && defined(CARRY)
+#define PD_FIX CAT(pd_fix, W)
+#define PD_RUN CAT(pd_run, W)
+#define PD_REL11 CAT(pd_rel11, W)
+#ifndef PR_SUP
+#define PR_SUP 1
+#define PR_CROSS 2
+#define PR_CELL 4
+#define PR_PAIR 8
+#define PR_ONE 16
+#endif
+/*
+ * Reference implementation (plain C, on a copy of the lists of depth d):
+ * the rules in `rules`, on both axis in turn (`first` first), each followed
+ * by the count and forward checks, until no list changes (with PR_ONE: the
+ * non-support rules in the first round only, then the support filter to its
+ * fixpoint, as the cascade does now). For a candidate u of axis f (h the
+ * other axis, Y = the unmatched cells of the placed f vectors, which need
+ * an h vector):
+ *   support: u lies within the placed h vectors and the union of H;
+ *   cross:   u meets U_y (union of the h candidates through y), every y in Y;
+ *   cell:    some h candidate through y meets u exactly once, every y in Y;
+ *   pair:    every free label z of u (not in a placed h vector) is in some
+ *            h candidate meeting u exactly at z.
+ * Returns 1 if the node is dead; *tests += pair tests made; *left = the
+ * entries left if alive.
+ */
+/* the fewest candidates through an unmatched cell (the number of children
+ * MRV would create), over the lists L[0..1] with k[0..1] entries */
+static uint32_t CAT(pd_mrv, W)(const uint64_t (*L)[8192][W], const uint32_t *k,
+                               const uint64_t *const *C) {
+  uint32_t best = ~0u;
+  for (int f = 0; f < 2; f++) {
+    const int h = 1 - f;
+    /* cells of placed h vectors not in placed f vectors need an f vector */
+    for (int w = 0; w < W; w++)
+      for (uint64_t t = C[h][w] & ~C[f][w]; t; t &= t - 1) {
+        const uint64_t bit = t & -t;
+        uint32_t c = 0;
+        for (uint32_t i = 0; i < k[f]; i++)
+          c += (L[f][i][w] & bit) != 0;
+        if (c < best)
+          best = c;
+      }
+  }
+  return best;
+}
+static int PD_FIX(const sstate_t *s, int d, int first, int rules,
+                  uint64_t *tests, uint64_t *left) {
+  const int n = s->n;
+  pd_last_mrv = 0;
+  static uint64_t L[2][8192][W];
+  static uint64_t Uy[64][W];
+  uint32_t k[2];
+  for (int a = 0; a < 2; a++) {
+    k[a] = s->nvalid[d][a];
+    if (k[a] > 8192)
+      return 0;
+    for (uint32_t i = 0; i < k[a]; i++)
+      for (int w = 0; w < W; w++)
+        L[a][i][w] = s->vw[d][a][w * s->cap + i];
+  }
+  const uint64_t *C[2] = {s->cells[d][ROW], s->cells[d][COL]};
+  int quiet = 0, round = 0, f = first;
+  while (quiet < 2) {
+    const int h = 1 - f;
+    int r = rules;
+    if ((rules & PR_ONE) && round >= 2)
+      r = PR_SUP;
+    uint64_t UH[W] = {0}, Y[W];
+    for (uint32_t j = 0; j < k[h]; j++)
+      for (int w = 0; w < W; w++)
+        UH[w] |= L[h][j][w];
+    int ny = 0;
+    int yw[64];
+    uint64_t yb[64];
+    for (int w = 0; w < W; w++) {
+      Y[w] = C[f][w] & ~C[h][w];
+      for (uint64_t t = Y[w]; t; t &= t - 1) {
+        if (ny < 64) {
+          yw[ny] = w;
+          yb[ny] = t & -t;
+        }
+        ny++;
+      }
+    }
+    if (ny > 64)
+      ny = 64;
+    if (r & PR_CROSS) {
+      for (int y = 0; y < ny; y++) {
+        for (int w = 0; w < W; w++)
+          Uy[y][w] = 0;
+        for (uint32_t j = 0; j < k[h]; j++)
+          if (L[h][j][yw[y]] & yb[y])
+            for (int w = 0; w < W; w++)
+              Uy[y][w] |= L[h][j][w];
+      }
+    }
+    uint32_t kk = 0;
+    for (uint32_t i = 0; i < k[f]; i++) {
+      const uint64_t *u = L[f][i];
+      int keep = 1;
+      if (r & PR_SUP)
+        for (int w = 0; w < W; w++)
+          keep &= (u[w] & ~(C[h][w] | UH[w])) == 0;
+      if (keep && (r & PR_CROSS))
+        for (int y = 0; y < ny && keep; y++) {
+          uint64_t hit = 0;
+          for (int w = 0; w < W; w++)
+            hit |= u[w] & Uy[y][w];
+          keep = hit != 0;
+        }
+      if (keep && (r & (PR_CELL | PR_PAIR))) {
+        uint64_t ys[W] = {0}, zs[W] = {0};
+        for (uint32_t j = 0; j < k[h]; j++) {
+          const uint64_t *v = L[h][j];
+          int c = 0;
+          for (int w = 0; w < W; w++)
+            c += __builtin_popcountll(u[w] & v[w]);
+          if (c == 1)
+            for (int w = 0; w < W; w++) {
+              ys[w] |= v[w] & Y[w];
+              zs[w] |= u[w] & v[w];
+            }
+        }
+        *tests += k[h];
+        if (r & PR_CELL)
+          for (int w = 0; w < W; w++)
+            keep &= (Y[w] & ~ys[w]) == 0;
+        if (r & PR_PAIR)
+          for (int w = 0; w < W; w++)
+            keep &= (u[w] & ~C[h][w] & ~zs[w]) == 0;
+      }
+      if (keep) {
+        if (kk != i)
+          for (int w = 0; w < W; w++)
+            L[f][kk][w] = u[w];
+        kk++;
+      }
+    }
+    {
+      const int changed = kk != k[f];
+      const int steady = !(rules & PR_ONE) || round >= 2;
+      quiet = changed || !steady ? 0 : quiet + 1;
+    }
+    k[f] = kk;
+    if (s->np[f] + (int)kk < n)
+      return 1;
+    /* forward check: the cells needing an f vector */
+    uint64_t UF[W] = {0};
+    for (uint32_t j = 0; j < k[f]; j++)
+      for (int w = 0; w < W; w++)
+        UF[w] |= L[f][j][w];
+    for (int w = 0; w < W; w++)
+      if (C[h][w] & ~C[f][w] & ~UF[w])
+        return 1;
+    round++;
+    f = h;
+    if (round > 400)
+      break;
+  }
+  *left += k[0] + k[1];
+  pd_last_mrv = CAT(pd_mrv, W)((const uint64_t(*)[8192][W])L, k, C);
+  return 0;
+}
+
+/* magic-only pruning: D = the vectors meeting every placed vector exactly
+ * once (possible diagonals, from all N vectors); a magic square needs two
+ * disjoint ones. At a (1,2)/(2,1) node: |D|, whether D has a disjoint pair,
+ * and how many of the MRV children keep a disjoint pair in D (the children
+ * a magic-only search would create). */
+#define PD_DIAG CAT(pd_diag, W)
+static void PD_DIAG(const sstate_t *s, int d) {
+  static uint32_t D[1 << 16];
+  uint32_t nd = 0;
+  for (uint32_t v = 0; v < s->N && nd < (1u << 16); v++) {
+    const uint64_t *vb = s->bits + (uint64_t)v * W;
+    int ok = 1;
+    for (int a = 0; a < 2 && ok; a++)
+      for (int i = 0; i < s->np[a] && ok; i++) {
+        int c = 0;
+        for (int w = 0; w < W; w++)
+          c += __builtin_popcountll(vb[w] & s->placedw[a][i][w]);
+        ok = c == 1;
+      }
+    if (ok)
+      D[nd++] = v;
+  }
+  /* disjoint pair within a subset given by a predicate on D */
+  pdd_n++;
+  pdd_sum += nd;
+  int pair = 0;
+  for (uint32_t i = 0; i < nd && !pair; i++)
+    for (uint32_t j = i + 1; j < nd && !pair; j++) {
+      const uint64_t *a = s->bits + (uint64_t)D[i] * W,
+                     *b = s->bits + (uint64_t)D[j] * W;
+      uint64_t hit = 0;
+      for (int w = 0; w < W; w++)
+        hit |= a[w] & b[w];
+      pair = hit == 0;
+    }
+  pdd_pair += pair;
+  /* the MRV cell and its candidates */
+  const uint64_t *C[2] = {s->cells[d][ROW], s->cells[d][COL]};
+  uint32_t best = ~0u;
+  int bf = -1, bw = 0;
+  uint64_t bbit = 0;
+  for (int f = 0; f < 2; f++) {
+    const int h = 1 - f;
+    for (int w = 0; w < W; w++)
+      for (uint64_t t = C[h][w] & ~C[f][w]; t; t &= t - 1) {
+        const uint64_t bit = t & -t;
+        uint32_t c = 0;
+        for (uint32_t i = 0; i < s->nvalid[d][f]; i++)
+          c += (s->vw[d][f][w * s->cap + i] & bit) != 0;
+        if (c < best) {
+          best = c;
+          bf = f;
+          bw = w;
+          bbit = bit;
+        }
+      }
+  }
+  if (bf < 0)
+    return;
+  uint32_t kids = 0, kept = 0, dsum = 0;
+  for (uint32_t i = 0; i < s->nvalid[d][bf]; i++) {
+    if (!(s->vw[d][bf][bw * s->cap + i] & bbit))
+      continue;
+    uint64_t kv[W];
+    for (int w = 0; w < W; w++)
+      kv[w] = s->vw[d][bf][w * s->cap + i];
+    kids++;
+    /* D of the child: D entries meeting the kid exactly once */
+    static uint32_t Dk[1 << 16];
+    uint32_t nk = 0;
+    for (uint32_t j = 0; j < nd; j++) {
+      const uint64_t *a = s->bits + (uint64_t)D[j] * W;
+      int c = 0;
+      for (int w = 0; w < W; w++)
+        c += __builtin_popcountll(a[w] & kv[w]);
+      if (c == 1)
+        Dk[nk++] = D[j];
+    }
+    dsum += nk;
+    int pr = 0;
+    for (uint32_t a1 = 0; a1 < nk && !pr; a1++)
+      for (uint32_t b1 = a1 + 1; b1 < nk && !pr; b1++) {
+        const uint64_t *a = s->bits + (uint64_t)Dk[a1] * W,
+                       *b = s->bits + (uint64_t)Dk[b1] * W;
+        uint64_t hit = 0;
+        for (int w = 0; w < W; w++)
+          hit |= a[w] & b[w];
+        pr = hit == 0;
+      }
+    kept += pr;
+  }
+  pdd_kids += kids;
+  pdd_kept += kept;
+  pdd_kd += dsum;
+}
+
+/* run the tests of point p on the node at depth d, as a bit set of kills */
+static int PD_RUN(const sstate_t *s, int d, int first, int p) {
+  static const int rules[PD_NT] = {
+      PR_ONE | PR_CROSS | PR_SUP, PR_ONE | PR_CELL | PR_SUP,
+      PR_CROSS | PR_SUP,          PR_CELL | PR_SUP,
+      PR_CELL | PR_PAIR | PR_CROSS | PR_SUP, PR_PAIR | PR_SUP};
+  int res = 0;
