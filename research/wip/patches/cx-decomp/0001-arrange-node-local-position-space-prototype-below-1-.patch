diff --git a/src/c/local11.h b/src/c/local11.h
new file mode 100644
index 0000000..97f67e6
--- /dev/null
+++ b/src/c/local11.h
@@ -0,0 +1,220 @@
+/*
+ * Prototype (cx/decomp): the subtree of a (1,1) node in the node-local
+ * position space of its lists (see lstate_t in arrange.c). Included from
+ * arrange_core.h on the carried path (W <= 4), with W defined.
+ */
+#define LOCAL_SOLVE CAT(local_solve, W)
+#define LREC CAT(lrec, W)
+#define LBUILD CAT(lbuild, W)
+
+/* out[i * nw + ...] = bitmask over B of the entries of B meeting A_i exactly
+ * once (once = 1) or disjoint from it (once = 0); A in AoS (4 words per
+ * entry), B in SoA with capacity capB, nw words per mask (multiple of 8) */
+static void LBUILD(const uint64_t *A, uint32_t nA, const uint64_t *BT,
+                   size_t capB, uint32_t nB, uint32_t nw, int once,
+                   uint64_t *out) {
+  const uint32_t nwb = (nB + 63) / 64; /* words with entries */
+  const uint64_t lastm =
+      (nB % 64) ? (((uint64_t)1 << (nB % 64)) - 1) : ~(uint64_t)0;
+  for (uint32_t i = 0; i < nA; i++) {
+    __m512i a[W];
+    for (int w = 0; w < W; w++)
+      a[w] = _mm512_set1_epi64((long long)A[i * 4 + w]);
+    uint64_t *row = out + (size_t)i * nw;
+    for (uint32_t jb = 0; jb < nwb; jb++) {
+      uint64_t word = 0;
+      for (int g = 0; g < 8; g++) {
+        const size_t j0 = (size_t)jb * 64 + 8 * g;
+        __mmask8 m;
+        if (once) {
+          __m512i pc = _mm512_popcnt_epi64(
+              _mm512_and_si512(_mm512_load_si512(BT + j0), a[0]));
+          for (int w = 1; w < W; w++)
+            pc = _mm512_add_epi64(
+                pc, _mm512_popcnt_epi64(_mm512_and_si512(
+                        _mm512_load_si512(BT + w * capB + j0), a[w])));
+          m = _mm512_cmpeq_epi64_mask(pc, _mm512_set1_epi64(1));
+        } else {
+          __m512i x = _mm512_and_si512(_mm512_load_si512(BT + j0), a[0]);
+          for (int w = 1; w < W; w++)
+            x = _mm512_ternarylogic_epi64(
+                x, _mm512_load_si512(BT + w * capB + j0), a[w], 0xF8);
+          m = _mm512_testn_epi64_mask(x, x);
+        }
+        word |= (uint64_t)m << (8 * g);
+      }
+      row[jb] = jb == nwb - 1 ? word & lastm : word;
+    }
+    for (uint32_t jb = nwb; jb < nw; jb++)
+      row[jb] = 0;
+  }
+}
+
+#ifndef LOCAL11_HELPERS
+#define LOCAL11_HELPERS
+static inline uint32_t lpopand(const uint64_t *a, const uint64_t *b,
+                               uint32_t nw) {
+  __m512i acc = _mm512_setzero_si512();
+  for (uint32_t i = 0; i < nw; i += 8)
+    acc = _mm512_add_epi64(
+        acc, _mm512_popcnt_epi64(_mm512_and_si512(_mm512_load_si512(a + i),
+                                                  _mm512_load_si512(b + i))));
+  return (uint32_t)_mm512_reduce_add_epi64(acc);
+}
+
+static inline void land(uint64_t *o, const uint64_t *a, const uint64_t *b,
+                        uint32_t nw) {
+  for (uint32_t i = 0; i < nw; i += 8)
+    _mm512_store_si512(o + i, _mm512_and_si512(_mm512_load_si512(a + i),
+                                               _mm512_load_si512(b + i)));
+}
+
+#endif
+
+/* lab bit of a W-word label set */
+#define LBIT(x, l) (((x)[(l) / 64] >> ((l) % 64)) & 1)
+
+static void LREC(sstate_t *s, lstate_t *L, int dep, int nr, int nc,
+                 const uint64_t *rc, const uint64_t *cc) {
+  const int n = s->n;
+  g_lnodes++;
+  g_lnode_lay[nr][nc]++;
+  if (nr == n && nc == n) {
+    report_bits(s, W);
+    return;
+  }
+  const uint32_t WR = L->WR, WC = L->WC;
+  const uint64_t *Rm = L->Rm + (size_t)dep * WR, *Cm = L->Cm + (size_t)dep * WC;
+  /* unmatched cells: of placed rows (need a col), of placed cols (need a
+   * row); the forward check and the cell with the fewest candidates */
+  int best = -1, bax = -1;
+  uint32_t bk = ~0u;
+  const int rows_only = g_lorder == 1 && nr < 3;
+  const int cols_only = g_lorder == 2 && nc < 3;
+  for (int w = 0; w < W; w++) {
+    uint64_t needc = rc[w] & ~cc[w], needr = cc[w] & ~rc[w];
+    for (; needr; needr &= needr - 1) {
+      const int l = 64 * w + __builtin_ctzll(needr);
+      const uint32_t k = lpopand(Rm, L->tR + (size_t)l * WR, WR);
+      if (!k)
+        return;
+      if (k < bk && !cols_only) {
+        bk = k;
+        best = l;
+        bax = ROW;
+      }
+    }
+    for (; needc; needc &= needc - 1) {
+      const int l = 64 * w + __builtin_ctzll(needc);
+      const uint32_t k = lpopand(Cm, L->tC + (size_t)l * WC, WC);
+      if (!k)
+        return;
+      if (k < bk && !rows_only) {
+        bk = k;
+        best = l;
+        bax = COL;
+      }
+    }
+  }
+  if (best < 0)
+    return;
+  uint64_t *Rn = L->Rm + (size_t)(dep + 1) * WR,
+           *Cn = L->Cm + (size_t)(dep + 1) * WC;
+  const uint32_t nwk = bax == ROW ? WR : WC;
+  uint64_t *K = L->K + (size_t)dep * (L->capR > L->capC ? L->capR : L->capC) / 64;
+  if (bax == ROW)
+    land(K, Rm, L->tR + (size_t)best * WR, WR);
+  else
+    land(K, Cm, L->tC + (size_t)best * WC, WC);
+  for (uint32_t kw = 0; kw < nwk; kw++)
+    for (uint64_t x = K[kw]; x; x &= x - 1) {
+      const uint32_t i = 64 * kw + (uint32_t)__builtin_ctzll(x);
+      uint64_t nrc[W], ncc[W];
+      if (bax == ROW) {
+        land(Rn, Rm, L->Dr + (size_t)i * WR, WR);
+        land(Cn, Cm, L->Mr + (size_t)i * WC, WC);
+        for (int w = 0; w < W; w++) {
+          nrc[w] = rc[w] | L->rb[i * 4 + w];
+          ncc[w] = cc[w];
+          s->placedw[ROW][nr][w] = L->rb[i * 4 + w];
+        }
+        LREC(s, L, dep + 1, nr + 1, nc, nrc, ncc);
+      } else {
+        land(Cn, Cm, L->Dc + (size_t)i * WC, WC);
+        land(Rn, Rm, L->Mc + (size_t)i * WR, WR);
+        for (int w = 0; w < W; w++) {
+          ncc[w] = cc[w] | L->cb[i * 4 + w];
+          nrc[w] = rc[w];
+          s->placedw[COL][nc][w] = L->cb[i * 4 + w];
+        }
+        LREC(s, L, dep + 1, nr, nc + 1, nrc, ncc);
+      }
+    }
+}
+
+/* the subtree of the (1,1) node at depth d */
+static void LOCAL_SOLVE(sstate_t *s, int d) {
+  lstate_t *L = &g_ls;
+  const uint64_t t0 = __rdtsc();
+  const uint32_t nR = s->nvalid[d][ROW], nC = s->nvalid[d][COL];
+  local_reserve(L, nR, nC);
+  L->nR = nR;
+  L->nC = nC;
+  L->WR = ((nR + 511) / 512) * 8;
+  L->WC = ((nC + 511) / 512) * 8;
+  const size_t cap = s->cap, capR = L->capR, capC = L->capC;
+  const uint32_t WR = L->WR, WC = L->WC;
+  /* the lists: SoA (zero-padded to whole masks) and AoS */
+  for (int w = 0; w < 4; w++) {
+    for (uint32_t i = 0; i < 64 * WR; i++) {
+      const uint64_t x = w < W && i < nR ? s->vw[d][ROW][w * cap + i] : 0;
+      if (w < W)
+        L->rT[w * capR + i] = x;
+      L->rb[i * 4 + w] = x;
+    }
+    for (uint32_t i = 0; i < 64 * WC; i++) {
+      const uint64_t x = w < W && i < nC ? s->vw[d][COL][w * cap + i] : 0;
+      if (w < W)
+        L->cT[w * capC + i] = x;
+      L->cb[i * 4 + w] = x;
+    }
+  }
+  LBUILD(L->rb, nR, L->cT, capC, nC, WC, 1, L->Mr);
+  LBUILD(L->cb, nC, L->rT, capR, nR, WR, 1, L->Mc);
+  LBUILD(L->rb, nR, L->rT, capR, nR, WR, 0, L->Dr);
+  LBUILD(L->cb, nC, L->cT, capC, nC, WC, 0, L->Dc);
+  memset(L->tR, 0, 256 * WR * 8);
+  memset(L->tC, 0, 256 * WC * 8);
+  for (uint32_t i = 0; i < nR; i++)
+    for (int w = 0; w < W; w++)
+      for (uint64_t x = L->rb[i * 4 + w]; x; x &= x - 1)
+        L->tR[(size_t)(64 * w + __builtin_ctzll(x)) * WR + i / 64] |=
+            (uint64_t)1 << (i % 64);
+  for (uint32_t i = 0; i < nC; i++)
+    for (int w = 0; w < W; w++)
+      for (uint64_t x = L->cb[i * 4 + w]; x; x &= x - 1)
+        L->tC[(size_t)(64 * w + __builtin_ctzll(x)) * WC + i / 64] |=
+            (uint64_t)1 << (i % 64);
+  /* all entries are candidates */
+  for (uint32_t k = 0; k < WR; k++)
+    L->Rm[k] = k < nR / 64 ? ~(uint64_t)0
+               : k == nR / 64 ? (((uint64_t)1 << (nR % 64)) - 1)
+                              : 0;
+  for (uint32_t k = 0; k < WC; k++)
+    L->Cm[k] = k < nC / 64 ? ~(uint64_t)0
+               : k == nC / 64 ? (((uint64_t)1 << (nC % 64)) - 1)
+                              : 0;
+  const uint64_t t1 = __rdtsc();
+  LREC(s, L, 0, 1, 1, s->cells[d][ROW], s->cells[d][COL]);
+  const uint64_t t2 = __rdtsc();
+  g_lsetup += t1 - t0;
+  g_lsearch += t2 - t1;
+  g_lcalls++;
+  g_lR += nR;
+  g_lC += nC;
+}
+
+#undef LOCAL_SOLVE
+#undef LREC
+#undef LBUILD
+#undef LBIT
