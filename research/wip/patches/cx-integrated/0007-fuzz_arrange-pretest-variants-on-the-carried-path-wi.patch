From 30c6ff3d8af0a83690d346f197b6873fdb7fad2f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 16:45:02 +0000
Subject: [PATCH 07/12] fuzz_arrange: pretest variants on the carried path with
 5-8 words

The pretest (FILTER_COUNT / FILTER_APPLY) was fuzzed only at 2-4 words,
since cx/pretest predates the carried 5-8 word instantiations of
cx/wide. Add variants with the pretest from 1-5 vectors placed at
--min-words 5, 6, 7, 8, with per-r1 widths and with every r1 at the full
width (fixw), and with cross support everywhere; each is also checked to
visit the same nodes as with the pretest off. Mode 7 (257-500 labels)
puts them on 5-8 words without --min-words.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GSaYLGdzq6d82nBLeSZFgB
---
 src/c/fuzz_arrange.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/c/fuzz_arrange.c b/src/c/fuzz_arrange.c
index 21a7c88..34470f6 100644
--- a/src/c/fuzz_arrange.c
+++ b/src/c/fuzz_arrange.c
@@ -919,6 +919,13 @@ static const variant_t variants[] = {
     {"pt_3", 1, 1, 1, 0, 0, 1, 0, 3},    {"pt_4", 1, 1, 1, 0, 0, 1, 0, 4},
     {"pt_1_w4", 1, 1, 1, 4, 0, 1, 0, 1}, {"pt_2_nosup", 1, 1, 0, 0, 0, 1, 0, 2},
     {"pt_2_nomrv", 1, 0, 1, 0, 0, 1, 0, 2}, {"pt_2_xcross", 1, 1, 1, 0, 0, 2, 0, 2},
+    /* the pretest on the carried path with 5-8 words (with the per-r1
+     * widths, every r1 at the width of all labels, and cross support
+     * everywhere) */
+    {"pt_1_w5", 1, 1, 1, 5, 0, 1, 0, 1}, {"pt_3_w6", 1, 1, 1, 6, 0, 1, 0, 3},
+    {"pt_4_w7_fixw", 1, 1, 1, 7, 0, 1, 1, 4},
+    {"pt_2_w8_xcross", 1, 1, 1, 8, 0, 2, 0, 2},
+    {"pt_5_w8_fixw", 1, 1, 1, 8, 0, 1, 1, 5},
 };
 #define NVAR (int)(sizeof(variants) / sizeof(variants[0]))
 
