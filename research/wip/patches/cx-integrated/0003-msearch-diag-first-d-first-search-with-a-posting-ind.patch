+                                   : (size_t)(splitmix(sd + 101) % d_stride);
+  const size_t hi = d_hi < raw ? d_hi : raw, lo = d_lo < hi ? d_lo : hi;
+  ctx->S = S;
+  ctx->magic_pairs = 0;
