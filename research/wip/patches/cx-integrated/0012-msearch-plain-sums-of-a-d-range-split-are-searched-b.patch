From 835e05242eded66d059993595348e5452eb14a61 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 16:51:23 +0000
Subject: [PATCH 12/13] msearch: plain sums of a --d-range split are searched
 by one unit only

--d-range lo:hi splits the d of a d-first sum between units, but a sum
below --diag-first-min-n in the same range was searched whole, plainly,
by every unit: k units cost k times its plain search, and wrote k copies
of its squares and "sum" record. Only the unit whose d-range starts at 0
searches it now; the others write a "skip" record for it, which
scheduler.py's Results cuts out of that file's "done" range like a
partial d-first sum. test_scheduler.py runs two d-range units over a
plain and a d-first sum and checks the records and the coverage.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GSaYLGdzq6d82nBLeSZFgB
---
 scripts/scheduler.py      |  5 ++++-
 scripts/test_scheduler.py | 29 +++++++++++++++++++++++++++++
 src/c/msearch.c           | 21 +++++++++++++++++++--
 3 files changed, 52 insertions(+), 3 deletions(-)

diff --git a/scripts/scheduler.py b/scripts/scheduler.py
index 2d1e391..4c7debe 100644
--- a/scripts/scheduler.py
+++ b/scripts/scheduler.py
@@ -237,7 +237,8 @@ class Results:
         except OSError:
             return
         # the sums of this file that its "done" records must not cover:
-        # d-first sums not searched in full
+        # d-first sums not searched in full, and the plain sums that a
+        # --d-range unit left to the unit of its range that starts at d 0
         partial = {}
         with f:
             for line in f:
@@ -262,6 +263,8 @@ class Results:
                         self.covered.setdefault(P, []).append((r["S"], r["S"]))
                     else:
                         partial.setdefault(P, set()).add(r["S"])
+                elif r["type"] == "skip":
+                    partial.setdefault(P, set()).add(r["S"])
                 elif r["type"] == "dsquare":
                     if r.get("magic") or r.get("partner"):
                         r["P"] = P
diff --git a/scripts/test_scheduler.py b/scripts/test_scheduler.py
index 28efb03..533b0ac 100644
--- a/scripts/test_scheduler.py
+++ b/scripts/test_scheduler.py
@@ -166,6 +166,35 @@ def test_dfirst_records():
                 return 327
         assert res.frontier(P, PI()) == 329, res.covered
         assert res.next_covered(P, 329) is None, res.covered
+    # --d-range units: a plain sum (below --diag-first-min-n) is searched
+    # by the unit whose range starts at 0 only, the others skip it
+    with tempfile.TemporaryDirectory() as d:
+        a, b = os.path.join(d, "a.jsonl"), os.path.join(d, "b.jsonl")
+        base = [msearch, "--diag-first", "--diag-first-min-n", "455", "--min-sum", "327",
+                "--max-sum", "328"]
+        subprocess.run(base + ["--d-range", "0:200", "--out", a, "10", "4", "3", "2"],
+                       check=True, capture_output=True)
+        subprocess.run(base + ["--d-range", "200:", "--out", b, "10", "4", "3", "2"],
+                       check=True, capture_output=True)
+        types = []
+        for path in (a, b):
+            with open(path) as f:
+                types.append([(json.loads(l)["type"], json.loads(l)["S"])
+                              for l in f if json.loads(l)["type"] in ("sum", "skip", "dsum")])
+        # S = 327 has 451 vectors after reduction (plain), 328 has 460
+        assert types[0] == [("sum", 327), ("dsum", 328)], types
+        assert types[1] == [("skip", 327), ("dsum", 328)], types
+        res = scheduler.Results(6)
+        res.add_file(b)
+
+        class PI:
+            def smin(self, P):
+                return 327
+        assert res.frontier(P, PI()) == 327, res.covered  # skipped, partial
+        res.add_file(a)
+        # 327 searched by unit a; 328's two d-range parts are not merged
+        # (yet), so it is not covered
+        assert res.frontier(P, PI()) == 328, res.covered
     print("d-first records ok")
 
 
diff --git a/src/c/msearch.c b/src/c/msearch.c
index bb3ab0e..50d9369 100644
--- a/src/c/msearch.c
+++ b/src/c/msearch.c
@@ -38,7 +38,10 @@
  *                     (an unbiased sample; o defaults to a random offset
  *                     from --sample-seed)
  *   --d-range lo:hi   only the d with index in [lo, hi) of the sum's
- *                     unreduced list (for splitting a sum into units)
+ *                     unreduced list (for splitting a sum into units); the
+ *                     plain sums (below --diag-first-min-n) are searched
+ *                     only by the unit with lo = 0, the others write a
+ *                     "skip" record for them
  *   --d-chunk C       a "dchunk" checkpoint record every C indices of d
  *                     (default 256)
  *   --d-log FILE      one line per d (see dfirst_search)
@@ -86,7 +89,9 @@
  * searched (not a --d-range part, a --d-stride sample, or a truncated
  * run). With --diag-first the "done" record has "mode":"dfirst" (and
  * diag_first_min_n): its range then also holds the d-first sums, which
- * have no "sum" record but are not empty. Sampled plain searches
+ * have no "sum" record but are not empty, and with --d-range lo:hi, lo > 0,
+ * the plain sums of the range get a "skip" record instead of a search
+ * (the unit whose range starts at 0 searches them). Sampled plain searches
  * (--calib-r1-stride, --r1-*) write "csquare" records (the squares of the sampled r1) and a "csum"
  * record with est_squares, se_squares, est_time, se_time (se_strata_missing:
  * the strata with fewer than 2 sampled r1, left out of the se_*).
@@ -706,6 +711,18 @@ int main(int argc, char *argv[]) {
         fprintf(out, "sum %lu nvecs %zu\n", (unsigned long)S, red.count);
       char pstr[64];
       pexp_to_str(&p, pstr, ",");
+      if (diag_first && red.count < dfirst_min_n && d_range_lo > 0) {
+        /* a plain sum in a --d-range unit: the units of a range split the
+         * d of its d-first sums between them, but a plain sum is searched
+         * whole, so only by the unit whose d-range starts at 0, not once
+         * per unit */
+        fprintf(out,
+                "{\"type\":\"skip\",\"mode\":\"dfirst\",\"n\":%d,\"P\":[%s],"
+                "\"S\":%lu,\"nvecs\":%zu,\"nvecs_raw\":%zu,\"d_lo\":%zu}\n",
+                n, pstr, (unsigned long)S, red.count, raw, d_range_lo);
+        fflush(out);
+        continue;
+      }
       if (diag_first && red.count >= dfirst_min_n) {
         total_nodes += run_dfirst(out, &ctx, pstr, n, &p, S, &all, start_i,
                                   raw, &red, &opts, d_stride, d_offset, seed,
