diff --git a/research/wip/c2-partner/partner.py b/research/wip/c2-partner/partner.py
new file mode 100644
index 0000000..b5ea384
--- /dev/null
+++ b/research/wip/c2-partner/partner.py
@@ -0,0 +1,92 @@
+# Partner candidates D2 at V_d-like nodes: d2 in the list, disjoint from d, meeting every placed
+# vector once; "inv" also requires a fixed-point-free involution iota on d's numbers with d2 on the
+# cells (a, iota(a)) of the placed rows/cols (box structure of a magic square).
+# usage: partner.py tag nsamples
+import sys, itertools, numpy as np
+tag = sys.argv[1]; ns = int(sys.argv[2])
+rng = np.random.default_rng(11)
+V = np.loadtxt(f'vec/{tag}.txt', dtype=np.int64); N = len(V)
+vals, inv = np.unique(V, return_inverse=True); inv = inv.reshape(V.shape); L = len(vals)
+sets = [frozenset(r) for r in inv]
+def meet(v):
+    m = np.zeros(L, bool); m[list(v)] = True
+    return m[inv].sum(1)
+# fixed-point-free involutions on 6 points
+def fpfi(pts):
+    if not pts: yield {}; return
+    a = pts[0]
+    for i in range(1, len(pts)):
+        b = pts[i]; rest = pts[1:i] + pts[i+1:]
+        for m in fpfi(rest):
+            mm = dict(m); mm[a] = b; mm[b] = a; yield mm
+INV = list(fpfi(list(range(6))))
+assert len(INV) == 15
+stats = {k: [] for k in ['d', 'r1', '11', '12', '22', '22inv', '23', '23inv', '33', '33inv']}
+def pick(mask):
+    idx = np.nonzero(mask)[0]
+    return None if len(idx) == 0 else int(rng.choice(idx))
+def invcheck(d, rows, cols, cand):
+    # rows/cols: lists of vector sets; dnum: index in d of the number each meets
+    dl = list(d)
+    rn = [dl.index(next(iter(r & d))) for r in rows]
+    cn = [dl.index(next(iter(c & d))) for c in cols]
+    y = [[next(iter(r & c)) for c in cols] for r in rows]
+    keep = 0
+    for i2 in cand:
+        s = sets[i2]
+        hr = [next(iter(s & r)) for r in rows]; hc = [next(iter(s & c)) for c in cols]
+        ok_any = False
+        for io in INV:
+            ok = True
+            for i, r in enumerate(rows):
+                tgt = io[rn[i]]
+                j = cn.index(tgt) if tgt in cn else -1
+                if j >= 0:
+                    if hr[i] != y[i][j]: ok = False; break
+                elif hr[i] in y[i]: ok = False; break
+            if ok:
+                for j, c in enumerate(cols):
+                    tgt = io[cn[j]]
+                    i = rn.index(tgt) if tgt in rn else -1
+                    if i >= 0:
+                        if hc[j] != y[i][j]: ok = False; break
+                    elif hc[j] in [y[k][j] for k in range(len(rows))]: ok = False; break
+            if ok: ok_any = True; break
+        keep += ok_any
+    return keep
+for it in range(ns):
+    di = int(rng.integers(N)); d = sets[di]
+    md = meet(d); Vd = md == 1; D2 = md == 0
+    cls = [(Vd & (inv == a).any(1)).sum() for a in d]
+    T = list(d)[int(np.argmin(cls))]
+    stats['d'].append(D2.sum())
+    hasT = (inv == T).any(1)
+    r1 = pick(Vd & hasT)
+    if r1 is None: continue
+    m1 = meet(sets[r1]); D2 = D2 & (m1 == 1); stats['r1'].append(D2.sum())
+    c1 = pick(Vd & (m1 == 1) & ~hasT)
+    if c1 is None: continue
+    mc1 = meet(sets[c1]); D2 = D2 & (mc1 == 1); stats['11'].append(D2.sum())
+    c2 = pick(Vd & (m1 == 1) & ~hasT & (mc1 == 0))
+    if c2 is None: continue
+    mc2 = meet(sets[c2]); D2 = D2 & (mc2 == 1); stats['12'].append(D2.sum())
+    dn = lambda v: next(iter(sets[v] & d))
+    used_c = {dn(c1), dn(c2)}
+    r2 = pick(Vd & (m1 == 0) & (mc1 == 1) & (mc2 == 1) & ~hasT)
+    if r2 is None: continue
+    mr2 = meet(sets[r2]); D2 = D2 & (mr2 == 1); stats['22'].append(D2.sum())
+    cand = np.nonzero(D2)[0]
+    stats['22inv'].append(invcheck(d, [sets[r1], sets[r2]], [sets[c1], sets[c2]], cand))
+    c3 = pick(Vd & (m1 == 1) & (mr2 == 1) & (mc1 == 0) & (mc2 == 0) & ~hasT)
+    if c3 is None: continue
+    mc3 = meet(sets[c3]); D2 = D2 & (mc3 == 1); stats['23'].append(D2.sum())
+    stats['23inv'].append(invcheck(d, [sets[r1], sets[r2]], [sets[c1], sets[c2], sets[c3]], np.nonzero(D2)[0]))
+    r3 = pick(Vd & (m1 == 0) & (mr2 == 0) & (mc1 == 1) & (mc2 == 1) & (mc3 == 1) & ~hasT)
+    if r3 is None: continue
+    mr3 = meet(sets[r3]); D2 = D2 & (mr3 == 1); stats['33'].append(D2.sum())
+    stats['33inv'].append(invcheck(d, [sets[r1], sets[r2], sets[r3]], [sets[c1], sets[c2], sets[c3]], np.nonzero(D2)[0]))
+out = [f'{tag} N {N}']
+for k, v in stats.items():
+    v = np.array(v)
+    if len(v): out.append(f'{k}: n {len(v)} mean {v.mean():.1f} med {np.median(v):.0f} P0 {(v==0).mean():.3f}')
+print(' | '.join(out))
