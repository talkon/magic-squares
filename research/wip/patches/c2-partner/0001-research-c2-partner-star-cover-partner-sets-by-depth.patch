diff --git a/research/wip/c2-partner/star.py b/research/wip/c2-partner/star.py
new file mode 100644
index 0000000..bf5120b
--- /dev/null
+++ b/research/wip/c2-partner/star.py
@@ -0,0 +1,57 @@
+# Star exclusion: share of the d-first cost held by the d that contain a number x.
+# usage: star.py tag  (reads vec/<tag>.txt and ../profile/runs/dprof.<tag>.dp)
+import sys, numpy as np
+tag = sys.argv[1]
+V = np.loadtxt(f'vec/{tag}.txt', dtype=np.int64); N = len(V)
+vals, inv = np.unique(V, return_inverse=True); inv = inv.reshape(V.shape); L = len(vals)
+B = np.zeros((N, L), np.float32); B[np.arange(N)[:, None], inv] = 1
+freq = B.sum(0) / N
+vd = np.zeros(N, np.int64); R = np.zeros(N, np.int64); C6 = np.zeros((N, 6), np.int64)
+for c0 in range(0, N, 1000):
+    c1 = min(N, c0 + 1000)
+    cnt = B @ B[c0:c1].T              # N x chunk: |v & d|
+    m = (cnt == 1).astype(np.float32)
+    vd[c0:c1] = m.sum(0)
+    cls = m.T @ B                     # chunk x L: class sizes
+    for j in range(c1 - c0):
+        cs = cls[j, inv[c0 + j]]
+        C6[c0 + j] = np.sort(cs); R[c0 + j] = cs.min()
+np.savez(f'vd_{tag}.npz', vd=vd, R=R, C6=C6, inv=inv, vals=vals)
+# measured per-d lines
+meas = []
+for l in open(f'../profile/runs/dprof.{tag}.dp'):
+    p = l.split()
+    if p[0] != 'D': continue
+    k = p.index('C'); cs = tuple(int(t) for t in p[k+1:k+7])
+    meas.append((int(p[2]), cs, int(p[4]), float(p[10])))
+key = {}
+for i in range(N): key.setdefault((int(vd[i]),) + tuple(int(t) for t in C6[i]), []).append(i)
+mi = []; mm = []
+for (v, cs, r, cyc) in meas:
+    c = key.get((v,) + cs, [])
+    if len(c) == 1: mi.append(c[0]); mm.append((c[0], v, r, cyc))
+print('matched uniquely', len(mi), 'of', len(meas))
+meas = np.array(mm, float); mi = np.array(mi)
+ok = (vd[mi] == meas[:, 1]).mean(), (R[mi] == meas[:, 2]).mean()
+X = np.c_[np.log(meas[:, 1]), np.log(meas[:, 2]), np.ones(len(meas))]
+coef, *_ = np.linalg.lstsq(X, np.log(meas[:, 3]), rcond=None)
+pred = np.exp(coef[0] * np.log(vd) + coef[1] * np.log(np.maximum(R, 1)) + coef[2])
+tot = pred.sum()
+share = (B.T @ pred) / tot           # per number: predicted cost share of its star
+cshare = freq                        # count share
+order = np.argsort(-share)
+mcyc = meas[:, 3]; mtot = mcyc.sum()
+print(f'{tag} N {N} L {L} match vd {ok[0]:.3f} R {ok[1]:.3f} fit a {coef[0]:.2f} b {coef[1]:.2f}; max freq {freq.max():.3f}')
+for x in order[:5]:
+    inx = B[mi, x] > 0
+    print(f'  x={vals[x]:5d} freq {freq[x]:.3f} pred cost share {share[x]:.3f}  (sampled d: {inx.sum():3d} of {len(mi)}, measured share {mcyc[inx].sum()/mtot:.3f}, pred share on sample {pred[mi][inx].sum()/pred[mi].sum():.3f})')
+# best 2-of-3 family among top-12 numbers by share
+top = order[:12]; best = (0, None)
+for a in range(12):
+    for b in range(a + 1, 12):
+        for c in range(b + 1, 12):
+            xs = [top[a], top[b], top[c]]
+            k = B[:, xs].sum(1) >= 2
+            s = pred[k].sum() / tot
+            if s > best[0]: best = (s, [vals[t] for t in xs])
+print(f'  best 2-of-3 family share {best[0]:.3f} {best[1]}')
