diff --git a/src/c/dpair2.c b/src/c/dpair2.c
new file mode 100644
index 0000000..bd302d7
--- /dev/null
+++ b/src/c/dpair2.c
@@ -0,0 +1,288 @@
+/*
+ * dpair2 (research driver, c2/partner): sampled cost of the "both diagonals
+ * first" search with a 12-number top-label root. For d1 = off, off + k, ...
+ * and m random d2 > d1 disjoint from d1, the semi-magic search on
+ *   V_{d1,d2} = { v : |v & d1| = |v & d2| = 1 }.
+ * Every square of V_{d1,d2} contains all 12 numbers of d1 and d2 (its rows
+ * meet each once and are disjoint), so the rarest of the 12 in V_{d1,d2}
+ * gets the top label and only the rows through it are roots (as d-first's
+ * top root with 6 numbers). Also prunes a pair outright when one of the 12
+ * numbers is in fewer than 2 vectors of V_{d1,d2} (a square needs a row and
+ * a col through it).
+ *
+ * usage: dpair2 --sum S [--stride k] [--offset o] [--m m] [--plain] e1 e2 ...
+ *        dpair2 --sum S --check K e1 e2 ...   (exactness: for every square
+ *        of the sum, K random pairs of disjoint traversals t1, t2 must find
+ *        it in V_{t1,t2} with the top root)
+ */
+#include <getopt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "arrange.h"
+#include "enumerate.h"
+#include "square.h"
+
+static double cpu_time(void) {
+  struct timespec t;
+  clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+  return (double)t.tv_sec + 1e-9 * (double)t.tv_nsec;
+}
+#define HB 16
+static uint64_t hkey[1 << HB];
+static int hval[1 << HB];
+static int hid(uint64_t x, int *L) {
+  uint32_t h = (uint32_t)((x * 0x9E3779B97F4A7C15ull) >> (64 - HB));
+  while (hval[h] && hkey[h] != x)
+    h = (h + 1) & ((1 << HB) - 1);
+  if (!hval[h]) {
+    hkey[h] = x;
+    hval[h] = ++*L;
+  }
+  return hval[h] - 1;
+}
+static inline int meet(const uint64_t *a, const uint64_t *b) {
+  int k = 0;
+  for (int w = 0; w < 8; w++)
+    k += __builtin_popcountll(a[w] & b[w]);
+  return k;
+}
+static void tobits(const uint64_t *v, int n, uint64_t *b, int *L) {
+  memset(b, 0, 8 * sizeof(uint64_t));
+  for (int i = 0; i < n; i++) {
+    int x = hid(v[i], L);
+    b[x / 64] |= 1ull << (x % 64);
+  }
+}
+
+typedef struct {
+  uint64_t count, target;
+  int hit;
+} cbctx_t;
+static int cb(const square_t *sq, void *vctx) {
+  cbctx_t *c = vctx;
+  c->count++;
+  if (c->target && square_hash(sq) == c->target)
+    c->hit++;
+  return 0;
+}
+
+/* V_{t1,t2} from red (bitsets rb) into sub; class counts of the 12 numbers;
+ * returns the smallest count, and top[] = the 12 numbers rarest first */
+static int build(const vec_list_t *red, const uint64_t *rb, const uint64_t *t1,
+                 const uint64_t *t2, const uint64_t *b1, const uint64_t *b2,
+                 int n, vec_list_t *sub, uint64_t *top) {
+  sub->count = 0;
+  uint64_t num[2 * SQ_MAX_N];
+  size_t cnt[2 * SQ_MAX_N] = {0};
+  for (int i = 0; i < n; i++) {
+    num[i] = t1[i];
+    num[n + i] = t2[i];
+  }
+  for (size_t v = 0; v < red->count; v++)
+    if (meet(b1, rb + v * 8) == 1 && meet(b2, rb + v * 8) == 1) {
+      const uint64_t *e = vec_list_get(red, v);
+      vec_list_push(sub, e);
+      for (int p = 0; p < n; p++)
+        for (int q = 0; q < 2 * n; q++)
+          cnt[q] += e[p] == num[q];
+    }
+  int ord[2 * SQ_MAX_N];
+  for (int q = 0; q < 2 * n; q++) {
+    int b = q;
+    for (; b > 0 && cnt[ord[b - 1]] > cnt[q]; b--)
+      ord[b] = ord[b - 1];
+    ord[b] = q;
+  }
+  for (int q = 0; q < 2 * n; q++)
+    top[q] = num[ord[q]];
+  return (int)cnt[ord[0]];
+}
+
+static int collect_cb(const square_t *sq, void *vctx) {
+  square_t **a = vctx;
+  static size_t cap = 0, cnt = 0;
+  if (cnt + 2 > cap) {
+    cap = cap ? 2 * cap : 64;
+    *a = realloc(*a, cap * sizeof(square_t));
+  }
+  (*a)[cnt++] = *sq;
+  (*a)[cnt].n = 0; /* terminator */
+  return 0;
+}
+
+int main(int argc, char *argv[]) {
+  search_opts_t opts;
+  search_opts_default(&opts);
+  static struct option lo[] = {{"sum", 1, 0, 's'},   {"stride", 1, 0, 'k'},
+                               {"offset", 1, 0, 'o'}, {"m", 1, 0, 'm'},
+                               {"plain", 0, 0, 'p'},  {"check", 1, 0, 'c'}, {"top6", 0, 0, '6'},
+                               {0, 0, 0, 0}};
+  int opt, plain = 0, check = 0, top6 = 0;
+  uint64_t S = 0;
+  size_t stride = 1, off = 0, m = 10;
+  while ((opt = getopt_long(argc, argv, "s:k:o:m:pc:6", lo, NULL)) != -1) {
+    if (opt == 's') S = strtoull(optarg, NULL, 10);
+    else if (opt == 'k') stride = strtoull(optarg, NULL, 10);
+    else if (opt == 'o') off = strtoull(optarg, NULL, 10);
+    else if (opt == 'm') m = strtoull(optarg, NULL, 10);
+    else if (opt == 'p') plain = 1;
+    else if (opt == 'c') check = atoi(optarg);
+    else if (opt == '6') top6 = 1;
+    else return 2;
+  }
+  prime_exps_t p;
+  if (!S || optind >= argc || pexp_parse(&p, argc - optind, argv + optind))
+    return 2;
+  const int n = 6;
+  vec_list_t all, red, sub;
+  vec_list_init(&all, n);
+  vec_list_init(&red, n);
+  vec_list_init(&sub, n);
+  enum_vectors(&p, n, S, S, &all);
+  reduce_vectors(&all, 0, all.count, &red, 0);
+  int L = 0;
+  uint64_t *ab = calloc(all.count * 8, sizeof(uint64_t));
+  uint64_t *rb = calloc(red.count * 8, sizeof(uint64_t));
+  for (size_t v = 0; v < all.count; v++)
+    tobits(vec_list_get(&all, v), n, ab + v * 8, &L);
+  for (size_t v = 0; v < red.count; v++)
+    tobits(vec_list_get(&red, v), n, rb + v * 8, &L);
+  srand(12345 + (unsigned)off);
+  uint64_t top[2 * SQ_MAX_N];
+
+  if (check) {
+    square_t *sqs = NULL;
+    search_stats_t st0 = search_vectors(&red, 0, red.count, &opts, collect_cb, &sqs);
+    size_t nsq = st0.squares, tests = 0, found = 0, pfound = 0, extra = 0;
+    for (size_t s = 0; s < nsq; s++) {
+      const square_t *sq = &sqs[s];
+      grid_t g;
+      square_to_grid(sq, &g);
+      uint64_t h = square_hash(sq);
+      for (int k = 0; k < check; k++) {
+        int sg[SQ_MAX_N], tu[SQ_MAX_N];
+        for (int i = 0; i < n; i++) sg[i] = i;
+        for (int i = n - 1; i > 0; i--) {
+          int j = rand() % (i + 1), t = sg[i];
+          sg[i] = sg[j];
+          sg[j] = t;
+        }
+        int ok;
+        do { /* a derangement relative to sg */
+          for (int i = 0; i < n; i++) tu[i] = i;
+          for (int i = n - 1; i > 0; i--) {
+            int j = rand() % (i + 1), t = tu[i];
+            tu[i] = tu[j];
+            tu[j] = t;
+          }
+          ok = 1;
+          for (int i = 0; i < n; i++) ok &= tu[i] != sg[i];
+        } while (!ok);
+        uint64_t t1[SQ_MAX_N], t2[SQ_MAX_N], b1[8], b2[8];
+        for (int i = 0; i < n; i++) {
+          t1[i] = g.g[i][sg[i]];
+          t2[i] = g.g[i][tu[i]];
+        }
+        tobits(t1, n, b1, &L);
+        tobits(t2, n, b2, &L);
+        int mn = build(&red, rb, t1, t2, b1, b2, n, &sub, top);
+        tests++;
+        if (mn < 2) continue; /* cannot happen for a square of V */
+        search_opts_t o = opts;
+        o.top_numbers = top;
+        o.n_top = 2 * n;
+        o.top_root_only = 1;
+        cbctx_t c = {0, h, 0};
+        search_vectors(&sub, 0, sub.count, &o, cb, &c);
+        found += c.hit > 0;
+        cbctx_t c2 = {0, h, 0};
+        search_vectors(&sub, 0, sub.count, &opts, cb, &c2);
+        pfound += c2.hit > 0;
+        extra += c.count != c2.count;
+      }
+    }
+    printf("check S %lu: %zu squares, %zu tests, top root found %zu, plain root found %zu, "
+           "square-count mismatches %zu\n",
+           (unsigned long)S, nsq, tests, found, pfound, extra);
+    return found == tests && pfound == tests && extra == 0 ? 0 : 1;
+  }
+
+  size_t *D = malloc(all.count * sizeof(size_t));
+  double pairs = 0, est[2] = {0, 0}, estn[2] = {0, 0}, estsetup[2] = {0, 0}, estsw[2] = {0, 0};
+  double estbuild = 0, sumV = 0, sumR = 0, ncalls = 0, nskip = 0;
+  uint64_t sq_top = 0, sq_plain = 0;
+  double c0 = cpu_time();
+  for (size_t d1 = off; d1 < all.count; d1 += stride) {
+    size_t nd = 0;
+    for (size_t d2 = d1 + 1; d2 < all.count; d2++)
+      if (meet(ab + d1 * 8, ab + d2 * 8) == 0)
+        D[nd++] = d2;
+    pairs += (double)nd;
+    if (!nd)
+      continue;
+    double t[2] = {0, 0}, nn[2] = {0, 0}, su[2] = {0, 0}, sw[2] = {0, 0}, tb = 0;
+    for (size_t j = 0; j < m; j++) {
+      size_t d2 = D[(size_t)rand() % nd];
+      double c1 = cpu_time();
+      int mn = build(&red, rb, vec_list_get(&all, d1), vec_list_get(&all, d2),
+                     ab + d1 * 8, ab + d2 * 8, n, &sub, top);
+      double c2 = cpu_time();
+      tb += c2 - c1;
+      ncalls++;
+      sumV += (double)sub.count;
+      sumR += mn;
+      if (mn < 2) {
+        nskip++;
+        continue;
+      }
+      for (int mode = 0; mode < 1 + plain; mode++) {
+        search_opts_t o = opts;
+        uint64_t t6[SQ_MAX_N];
+        if (mode == 0) {
+          o.top_numbers = top;
+          o.n_top = 2 * n;
+          o.top_root_only = 1;
+          if (top6) { /* d1's numbers only, rarest first (V_{d1}-style root) */
+            const uint64_t *e1 = vec_list_get(&all, d1);
+            int k6 = 0;
+            for (int q = 0; q < 2 * n; q++)
+              for (int i = 0; i < n; i++)
+                if (top[q] == e1[i]) t6[k6++] = top[q];
+            o.top_numbers = t6;
+            o.n_top = n;
+          }
+        }
+        cbctx_t c = {0, 0, 0};
+        double c3 = cpu_time();
+        search_stats_t st = search_vectors(&sub, 0, sub.count, &o, cb, &c);
+        t[mode] += cpu_time() - c3;
+        nn[mode] += (double)st.nodes;
+        su[mode] += st.setup_seconds;
+        sw[mode] += st.seconds;
+        if (mode == 0) sq_top += c.count; else sq_plain += c.count;
+      }
+    }
+    for (int mode = 0; mode < 2; mode++) {
+      est[mode] += (double)nd * t[mode] / (double)m;
+      estn[mode] += (double)nd * nn[mode] / (double)m;
+      estsetup[mode] += (double)nd * su[mode] / (double)m;
+      estsw[mode] += (double)nd * sw[mode] / (double)m;
+    }
+    estbuild += (double)nd * tb / (double)m;
+  }
+  printf("S %lu N %zu red %zu L %d: pairs %.4g avg|V| %.1f avg min-class %.1f "
+         "pruned(min<2) %.3f | V build %.4g s | top root: search+setup %.4g s "
+         "(setup %.4g, search timer %.4g) nodes %.4g squares %lu",
+         (unsigned long)S, all.count, red.count, L, pairs * stride, sumV / ncalls,
+         sumR / ncalls, nskip / ncalls, estbuild * stride, est[0] * stride,
+         estsetup[0] * stride, estsw[0] * stride, estn[0] * stride, (unsigned long)sq_top);
+  if (plain)
+    printf(" | plain root: %.4g s (setup %.4g, search timer %.4g) nodes %.4g squares %lu",
+           est[1] * stride, estsetup[1] * stride, estsw[1] * stride, estn[1] * stride,
+           (unsigned long)sq_plain);
+  printf(" | calls %.0f cpu used %.1f s\n", ncalls, cpu_time() - c0);
+  return 0;
+}
-- 
