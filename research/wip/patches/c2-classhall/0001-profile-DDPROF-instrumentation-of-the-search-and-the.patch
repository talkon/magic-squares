--- a/src/c/arrange.c
+++ b/src/c/arrange.c
@@ -252,6 +252,15 @@ typedef struct {
     double t, t2, q, q2, nodes;
   } r1s[8];
   uint32_t *r1_list, r1_nlist;
+#ifdef DPROF
+  /* with dprof_vec: bitset -> vector index (open addressing, index + 1),
+   * the deepest searched node of each vector, and the vectors placed on
