--- a/src/c/arrange.h
+++ b/src/c/arrange.h
@@ -109,6 +109,45 @@ typedef struct {
 
 void search_opts_default(search_opts_t *o);
 
+#ifdef DPROF
+/*
+ * Instrumentation for the profile of the search (build with -DDPROF; never
+ * in the default build): cumulative counters, which callers snapshot and
+ * difference (dfirst.c writes one line per d). Layers are 9 r + c of the
+ * node or child (r rows, c cols placed). Carried path only.
+ */
+#define DP_NL 81
+#define DP_MAXD 18
+typedef struct {
+  uint64_t made[DP_NL];   /* children created, by the child's layer */
+  uint64_t live[DP_NL];   /* of them searched (survived their filters) */
+  uint64_t mk[DP_NL];     /* TSC cycles creating them (TRY_CHILD up to the
+                             call of SEARCH_REC, i.e. without the subtree) */
+  uint64_t sel[DP_NL];    /* TSC cycles of MRV + selection of the children
+                             at the searched nodes of the layer */
+  uint64_t kids[DP_NL];   /* children selected at the searched nodes */
+  uint64_t in[DP_NL][2];  /* parent list lengths o, b, summed per child */
+  uint64_t out[DP_NL][2]; /* lengths after filter o, b (children that got
+                             that far) */
+  uint64_t nout[DP_NL][2];/* children that got that far */
+  uint64_t lst[DP_NL][2]; /* row / col list lengths of the searched nodes */
+  uint64_t setup, root, total; /* TSC cycles: setup of search_vectors, the
+                                  depth-0 list fills, the root loops */
+  uint64_t roots, nvec, searches;
+  /* the support filter's kills at the children, by layer: by count, by a
+   * dead cell, of those a dead cell that is a top label (one of d's
+   * numbers in a V_d search), a cell of the new vector, only top labels;
+   * the support rounds run (passes over one axis) */
+  uint64_t sk_cnt[DP_NL], sk_fc[DP_NL], sk_top[DP_NL], sk_new[DP_NL],
+      sk_toponly[DP_NL], sk_rounds[DP_NL], sk_calls[DP_NL], sk_axis_o[DP_NL];
+  uint64_t vused[DP_MAXD]; /* with dprof_vec: vectors placed in some
+                              searched node with >= k vectors placed
+                              (vused[12]: in a square) */
+} dprof_t;
+extern dprof_t dprof;
+extern int dprof_vec;
+#endif
+
 /* will a search of `labels` distinct numbers with opts carry its bitsets
  * in the candidate lists (1), or use the N x N intersection matrices (0)?
  * (see CARRY_MAX_W in arrange.c) */
