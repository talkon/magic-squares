+#endif
 } sstate_t;
 
 static inline bool bit_get(const uint64_t *row, uint32_t u) {
@@ -505,6 +514,66 @@ static void report_bits(sstate_t *s, int W) {
 }
 #endif
 
+#ifdef DPROF
+#include <x86intrin.h>
+dprof_t dprof;
+int dprof_vec;
+/* the last SUPPORT call: 1 killed by count, 2 by a dead cell (mask), the
+ * axis it died on, passes run */
+int dp_sw, dp_sax, dp_srounds;
+uint64_t dp_sdead[CARRY_WORDS];
+static void __attribute__((destructor)) dp_print(void) {
+  for (int l = 0; l < DP_NL; l++)
+    if (dprof.sk_calls[l])
+      fprintf(stderr,
+              "dprof support (%d,%d): calls %lu rounds/call %.2f killed by "
+              "count %lu, by a dead cell %lu (a top label %lu, top labels "
+              "only %lu, a cell of the new vector %lu), on the axis o %lu\n",
+              l / 9, l % 9, (unsigned long)dprof.sk_calls[l],
+              (double)dprof.sk_rounds[l] / dprof.sk_calls[l],
+              (unsigned long)dprof.sk_cnt[l], (unsigned long)dprof.sk_fc[l],
+              (unsigned long)dprof.sk_top[l],
+              (unsigned long)dprof.sk_toponly[l],
+              (unsigned long)dprof.sk_new[l],
+              (unsigned long)dprof.sk_axis_o[l]);
+}
+static inline uint32_t dp_hash(const uint64_t *m, int W_, int bits) {
+  uint64_t h = 0x9E3779B97F4A7C15ull;
+  for (int w = 0; w < W_; w++)
+    if (m[w])
+      h ^= (m[w] + (uint64_t)w * 0x632BE59BD9B4E019ull) * 0xBF58476D1CE4E5B9ull;
+  h ^= h >> 29;
+  h *= 0x94D049BB133111EBull;
+  return (uint32_t)(h >> (64 - bits));
+}
+/* the index of the vector with bitset m (W_ words, the others 0) */
+static uint32_t dp_lookup(const sstate_t *s, const uint64_t *m, int W_) {
+  const uint32_t mask = (1u << s->dp_hbits) - 1;
+  for (uint32_t h = dp_hash(m, W_, s->dp_hbits);; h = (h + 1) & mask) {
+    const uint32_t e = s->dp_ht[h];
+    if (!e)
+      return UINT32_MAX;
+    const uint64_t *b = s->bits + (uint64_t)(e - 1) * s->bw;
+    int eq = 1;
+    for (int w = 0; w < s->bw; w++)
+      eq &= b[w] == (w < W_ ? m[w] : 0);
+    if (eq)
+      return e - 1;
+  }
+}
+/* a searched node (or a square) at depth dd: mark its vectors */
+static inline void dp_mark(sstate_t *s, int dd, const uint64_t *m, int W_) {
+  if (!s->dp_ht)
+    return;
+  s->dp_ids[dd] = dp_lookup(s, m, W_);
+  for (int k = 1; k <= dd; k++) {
+    const uint32_t v = s->dp_ids[k];
+    if (v != UINT32_MAX && s->dp_maxd[v] < dd)
+      s->dp_maxd[v] = (uint8_t)dd;
+  }
+}
+#endif
+
 #ifdef PROFILE
 /* per depth: children created, children pruned before being searched, and
  * for the searched ones, children generated and candidates on each axis */
@@ -903,6 +972,9 @@ search_stats_t search_vectors(const vec_list_t *l, size_t start, size_t count,
   if (count < (size_t)(2 * n) || n > SQ_MAX_N)
     return st;
   double t0 = wall_time();
+#ifdef DPROF
+  const uint64_t dp_t0 = __rdtsc();
+#endif
 
   sstate_t s;
   memset(&s, 0, sizeof(s));
@@ -1175,9 +1247,38 @@ search_stats_t search_vectors(const vec_list_t *l, size_t start, size_t count,
   if (carry)
     for (int a = 0; a < 2; a++)
       s.ptmask[a] = malloc(s.cap / 8 + 1);
+#ifdef DPROF
+  if (dprof_vec) {
+    s.dp_hbits = 4;
+    while (((size_t)1 << s.dp_hbits) < 2 * count + 16)
+      s.dp_hbits++;
+    s.dp_ht = calloc((size_t)1 << s.dp_hbits, sizeof(uint32_t));
+    s.dp_maxd = calloc(count + 1, 1);
+    const uint32_t hm = (1u << s.dp_hbits) - 1;
+    for (size_t v = 0; v < count; v++) {
+      uint32_t h = dp_hash(s.bits + v * W_, W_, s.dp_hbits);
+      while (s.dp_ht[h])
+        h = (h + 1) & hm;
+      s.dp_ht[h] = (uint32_t)v + 1;
+    }
+  }
+  dprof.setup += __rdtsc() - dp_t0;
+  dprof.roots += s.root_limit < s.N ? s.root_limit : s.N;
+  dprof.nvec += count;
+  dprof.searches++;
+#endif
   double t1 = wall_time();
 
   search_root(&s, W_, carry);
+#ifdef DPROF
+  if (s.dp_ht) {
+    for (size_t v = 0; v < count; v++)
+      for (int k = 1; k <= s.dp_maxd[v] && k < DP_MAXD; k++)
+        dprof.vused[k]++;
+    free(s.dp_ht);
+    free(s.dp_maxd);
+  }
+#endif
 
   free(s.r1_list);
   st.nodes = s.nodes;
diff --git a/src/c/arrange.h b/src/c/arrange.h
