diff --git a/src/c/dfirst.c b/src/c/dfirst.c
index 3013f78..8ffc331 100644
--- a/src/c/dfirst.c
+++ b/src/c/dfirst.c
@@ -12,6 +12,62 @@
 
 #include "square.h"
 
+#ifdef DPROF
+/* the profile's per-d lines (-DDPROF; env DPROF_LOG names the file,
+ * DPROF_VEC=1 marks the vectors of the searched nodes) */
+#include <x86intrin.h>
+static FILE *dp_log;
+static int dp_init;
+static void dp_open(void) {
+  if (dp_init)
+    return;
+  dp_init = 1;
+  const char *f = getenv("DPROF_LOG");
+  if (f)
+    dp_log = fopen(f, "a");
+  const char *v = getenv("DPROF_VEC");
+  dprof_vec = v && atoi(v) > 0;
+}
+static void dp_write(size_t i, size_t vd, int labels, uint64_t nodes,
+                     uint64_t pairs, uint64_t vd_cyc, const size_t *cls,
+                     int n, const dprof_t *a, const dprof_t *b, double cpu) {
+  if (!dp_log)
+    return;
+  fprintf(dp_log, "D %zu %zu %d %lu %lu %lu %lu %lu %lu %lu %lu %.6f C", i, vd,
+          labels, (unsigned long)(b->roots - a->roots),
+          (unsigned long)nodes, (unsigned long)pairs, (unsigned long)vd_cyc,
+          (unsigned long)(b->setup - a->setup),
+          (unsigned long)(b->root - a->root),
+          (unsigned long)(b->total - a->total),
+          (unsigned long)(b->searches - a->searches), cpu);
+  for (int q = 0; q < n; q++)
