++  for (int k = 1; k <= dd; k++) {
++    const uint32_t v = s->dp_ids[k];
++    if (v != UINT32_MAX && s->dp_maxd[v] < dd)
++      s->dp_maxd[v] = (uint8_t)dd;
++  }
++}
